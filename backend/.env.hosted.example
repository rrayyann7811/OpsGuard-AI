# app.hosted:app only; the entry point ignores dotenv files.
# Set values in Render's environment dashboard; never copy local tokens/database URLs.
ENVIRONMENT=production
MONITOR_ENABLED=false
AGENT_EXECUTION_ENABLED=false
AGENT_MANAGED_ENABLED=false
AGENT_MANAGED_HTTP_ENABLED=false
ENABLE_INCIDENT_MANAGEMENT=false
# Closed to browser cross-origin access until an actual frontend origin is assigned.
CORS_ORIGINS=[]
