# Public build-time values only. No credentials belong here.
# Local full-stack defaults (use frontend/.env.local privately):
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Vercel's build:demo explicitly sets NEXT_PUBLIC_DEMO_MODE=true.
# Public demo makes no API requests and requires no API URL or secrets.

# Hosted read-only API mode (separate from synthetic demo).
NEXT_PUBLIC_HOSTED_API=false
# Set true only with NEXT_PUBLIC_DEMO_MODE=false and a real public HTTPS API origin.
# NEXT_PUBLIC_API_URL=https://YOUR_ACTUAL_RENDER_SERVICE.onrender.com
