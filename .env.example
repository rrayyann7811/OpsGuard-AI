# Copy to backend/.env. CORS_ORIGINS must be a JSON array.
APP_NAME="OpsGuard AI"
ENVIRONMENT=development
DATABASE_URL=sqlite:///./opsguard.db
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Copy this line to frontend/.env.local (optional; this is the default).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Phase 3 backend: configure the SAME private token in each Node service environment.
INCIDENT_WEBHOOK_TOKEN=
DEDUP_WINDOW_SECONDS=300
MONITOR_ENABLED=true
MONITOR_INTERVAL_SECONDS=10
MONITOR_TIMEOUT_SECONDS=1
USER_SERVICE_URL=http://127.0.0.1:3001
ORDER_SERVICE_URL=http://127.0.0.1:3002
PAYMENT_SERVICE_URL=http://127.0.0.1:3003
ENABLE_INCIDENT_MANAGEMENT=false
INCIDENT_MANAGEMENT_TOKEN=
# Services-only (backend ignores this): set explicitly for direct Node or Docker routing.
INCIDENT_INGESTION_URL=http://127.0.0.1:8000/api/incidents/events

# Phase 4: optional local retrieval. Empty URL selects embedded persistent local storage.
QDRANT_URL=
QDRANT_API_KEY=
# QDRANT_PATH defaults to the absolute project knowledge/.qdrant directory.
QDRANT_COLLECTION=opsguard_history_v1
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_REVISION=c9745ed1d9f207416be6d2e6f8de32d1f16199bf
EMBEDDING_DIMENSION=384
EMBEDDING_LOCAL_ONLY=true

# Phase 5: disabled by default. Never put agent credentials in NEXT_PUBLIC variables.
AGENT_EXECUTION_ENABLED=false
AGENT_AUTH_TOKEN=
AGENT_CODEX_API_KEY=
AGENT_CODEX_MODEL=
# AGENT_PROJECT_ROOT defaults to this project; source scope remains restricted.
AGENT_TIMEOUT_SECONDS=90
AGENT_QUEUE_LIMIT=8

# Phase 5.8: explicit selection, never automatic fallback.
# local-ollama (selected) | local-codex | managed-codex | test-double
AGENT_EXECUTION_BACKEND=local-ollama
# Select an already installed, local GGUF model explicitly. No automatic download/start.
AGENT_OLLAMA_URL=http://127.0.0.1:11434
AGENT_OLLAMA_MODEL=llama3.2:3b
AGENT_OLLAMA_TIMEOUT_SECONDS=60
AGENT_OLLAMA_RETRIES=1
AGENT_OLLAMA_MAX_PROMPT_BYTES=24576
AGENT_OLLAMA_MAX_OUTPUT_BYTES=16384
AGENT_OLLAMA_CONTEXT_TOKENS=8192
AGENT_OLLAMA_OUTPUT_TOKENS=1536
AGENT_OLLAMA_MAX_MODEL_BYTES=2500000000
AGENT_OLLAMA_MIN_AVAILABLE_BYTES=2147483648
# Offline adapter only: no live transport or billing credentials are installed.
# Setting this true does NOT enable a real managed sandbox.
AGENT_MANAGED_ENABLED=false
AGENT_MANAGED_MODEL=
AGENT_MANAGED_MAX_INVESTIGATIONS_PER_SESSION=1
AGENT_MANAGED_MAX_CONCURRENT_SESSIONS=1
AGENT_MANAGED_MAX_EVIDENCE_BYTES=131072
AGENT_MANAGED_MAX_OUTPUT_BYTES=131072
AGENT_MANAGED_DURATION_SECONDS=60
AGENT_MANAGED_POLL_SECONDS=0.05
AGENT_MANAGED_CLEANUP_SECONDS=2
# Exact reviewed synthetic bundle digests; never approve arbitrary production evidence.
AGENT_MANAGED_SYNTHETIC_DIGESTS=[]

# Phase 5.9: mocked HTTP readiness only. Real transports remain ineligible.
AGENT_MANAGED_HTTP_ENABLED=false
AGENT_MANAGED_REQUEST_TIMEOUT_SECONDS=2
# Includes retries/pages; four attempts are reserved for cancel/delete cleanup.
AGENT_MANAGED_MAX_REQUESTS=32
AGENT_MANAGED_HTTP_RETRIES=1
AGENT_MANAGED_RETRY_DELAY_SECONDS=0.01
AGENT_MANAGED_MAX_RESPONSE_BYTES=262144
AGENT_MANAGED_MAX_PAGES=4
# No real API credential is configured or read by the mocked transport.
